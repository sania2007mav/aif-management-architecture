// Возвращает организации периметра, входящие в консолидацию.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Организации
//
Функция ОрганизацииПериметраКонсолидации() Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периметр.Организация КАК Организация
	|ИЗ
	|	Справочник.АиФ_ПериметрГруппы КАК Периметр
	|ГДЕ
	|	НЕ Периметр.ПометкаУдаления
	|	И Периметр.ВходитВКонсолидацию
	|
	|УПОРЯДОЧИТЬ ПО
	|	Периметр.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Организация) Тогда
			Результат.Добавить(Выборка.Организация);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает активные правила исключения ВГО.
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция АктивныеПравилаВГО() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Ссылка КАК Правило,
	|	Правила.ОрганизацияПродавец КАК ОрганизацияПродавец,
	|	Правила.ОрганизацияПокупатель КАК ОрганизацияПокупатель,
	|	Правила.КонтрагентПродавец КАК КонтрагентПродавец,
	|	Правила.КонтрагентПокупатель КАК КонтрагентПокупатель,
	|	Правила.КодСчетаВыручки КАК КодСчетаВыручки,
	|	Правила.КодСчетаЗатрат КАК КодСчетаЗатрат
	|ИЗ
	|	Справочник.АиФ_ПравилаВГО КАК Правила
	|ГДЕ
	|	НЕ Правила.ПометкаУдаления
	|	И Правила.Активно";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Карта счетов БП → статьи МСФО (только активные).
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция АктивнаяКартаСчетовМСФО() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карта.Ссылка КАК Правило,
	|	Карта.КодСчетаБП КАК КодСчетаБП,
	|	Карта.СтатьяМСФО КАК СтатьяМСФО,
	|	Карта.ВидОперации КАК ВидОперации,
	|	Карта.ПереклассифицироватьВРасходПериода КАК ПереклассифицироватьВРасходПериода
	|ИЗ
	|	Справочник.АиФ_КартаСчетовМСФО КАК Карта
	|ГДЕ
	|	НЕ Карта.ПометкаУдаления
	|	И Карта.Активно";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

