// АиФ: серверные процедуры слоя МСФО / консолидации.
// Проводки БП не изменяются — работаем только с объектами расширения.

#Область ПрограммныйИнтерфейс

Функция ОрганизацииПериметраКонсолидации() Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периметр.Организация КАК Организация
	|ИЗ
	|	Справочник.АиФ_ПериметрГруппы КАК Периметр
	|ГДЕ
	|	НЕ Периметр.ПометкаУдаления
	|	И Периметр.ВходитВКонсолидацию
	|
	|УПОРЯДОЧИТЬ ПО
	|	Периметр.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Организация) Тогда
			Результат.Добавить(Выборка.Организация);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АктивныеПравилаВГО() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Ссылка КАК Правило,
	|	Правила.Наименование КАК Наименование,
	|	Правила.ОрганизацияПродавец КАК ОрганизацияПродавец,
	|	Правила.ОрганизацияПокупатель КАК ОрганизацияПокупатель,
	|	Правила.КонтрагентПродавец КАК КонтрагентПродавец,
	|	Правила.КонтрагентПокупатель КАК КонтрагентПокупатель,
	|	Правила.КодСчетаВыручки КАК КодСчетаВыручки,
	|	Правила.КодСчетаЗатрат КАК КодСчетаЗатрат
	|ИЗ
	|	Справочник.АиФ_ПравилаВГО КАК Правила
	|ГДЕ
	|	НЕ Правила.ПометкаУдаления
	|	И Правила.Активно";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция АктивнаяКартаСчетовМСФО() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карта.Ссылка КАК Правило,
	|	Карта.КодСчетаБП КАК КодСчетаБП,
	|	Карта.СтатьяМСФО КАК СтатьяМСФО,
	|	Карта.ВидОперации КАК ВидОперации,
	|	Карта.ПереклассифицироватьВРасходПериода КАК ПереклассифицироватьВРасходПериода
	|ИЗ
	|	Справочник.АиФ_КартаСчетовМСФО КАК Карта
	|ГДЕ
	|	НЕ Карта.ПометкаУдаления
	|	И Карта.Активно";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Обороты типового плана счетов БП по кодам из карты (или переданному списку).
//
Функция ОборотыБППоКодамСчетов(Организация, ДатаНачала, ДатаОкончания, КодыСчетов = Неопределено) Экспорт

	Если КодыСчетов = Неопределено Тогда
		Карта = АктивнаяКартаСчетовМСФО();
		КодыСчетов = Карта.ВыгрузитьКолонку("КодСчетаБП");
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КодСчетаБП", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("СуммаДт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Результат.Колонки.Добавить("СуммаКт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Если КодыСчетов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты.Счет.Код КАК КодСчетаБП,
	|	СУММА(Обороты.СуммаОборотДт) КАК СуммаДт,
	|	СУММА(Обороты.СуммаОборотКт) КАК СуммаКт
	|ИЗ
	|	РегистрБухгалтерии.Типовой.Обороты(&ДатаНачала, &ДатаОкончания, , , , Организация = &Организация) КАК Обороты
	|ГДЕ
	|	Обороты.Счет.Код В (&КодыСчетов)
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Счет.Код";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КодыСчетов", КодыСчетов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.КодСчетаБП = Выборка.КодСчетаБП;
		Строка.СуммаДт = Выборка.СуммаДт;
		Строка.СуммаКт = Выборка.СуммаКт;
		// Для затратных счетов берём Дт, для доходных — Кт.
		Если Выборка.СуммаДт >= Выборка.СуммаКт Тогда
			Строка.Сумма = Выборка.СуммаДт;
		Иначе
			Строка.Сумма = Выборка.СуммаКт;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет табличную часть документа корректировки по активной карте счетов и оборотам БП.
//
Процедура ЗаполнитьКорректировкуПоКарте(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена организация документа.'");
	КонецЕсли;

	ДатаОкончания = ?(ЗначениеЗаполнено(ДокументОбъект.ПериодОтчёта), КонецМесяца(ДокументОбъект.ПериодОтчёта), КонецМесяца(ДокументОбъект.Дата));
	// Берём год отчётной даты: помесячных оборотов по карте часто нет, а годовые есть.
	ДатаНачала = НачалоГода(ДатаОкончания);

	Карта = АктивнаяКартаСчетовМСФО();
	Если Карта.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет активных строк в карте счетов МСФО.'");
	КонецЕсли;

	Коды = Карта.ВыгрузитьКолонку("КодСчетаБП");
	Обороты = ОборотыБППоКодамСчетов(ДокументОбъект.Организация, ДатаНачала, ДатаОкончания, Коды);
	Обороты.Индексы.Добавить("КодСчетаБП");

	ДокументОбъект.Строки.Очистить();

	Для Каждого СтрокаКарты Из Карта Цикл

		Найденные = Обороты.НайтиСтроки(Новый Структура("КодСчетаБП", СтрокаКарты.КодСчетаБП));
		Сумма = 0;
		Если Найденные.Количество() > 0 Тогда
			Сумма = Найденные[0].Сумма;
		КонецЕсли;

		Если Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокументОбъект.Строки.Добавить();
		НоваяСтрока.КодСчетаБП = СтрокаКарты.КодСчетаБП;
		НоваяСтрока.СтатьяМСФО = СтрокаКарты.СтатьяМСФО;
		НоваяСтрока.Сумма = Сумма;
		НоваяСтрока.Содержание = ?(СтрокаКарты.ПереклассифицироватьВРасходПериода,
			НСтр("ru = 'Переклассификация в расход периода (МСФО)'"),
			НСтр("ru = 'Корректировка по карте счетов МСФО'"));

		Если Не ЗначениеЗаполнено(ДокументОбъект.ВидОперации) И ЗначениеЗаполнено(СтрокаКарты.ВидОперации) Тогда
			ДокументОбъект.ВидОперации = СтрокаКарты.ВидОперации;
		КонецЕсли;

	КонецЦикла;

	Если Не ЗначениеЗаполнено(ДокументОбъект.ПериодОтчёта) Тогда
		ДокументОбъект.ПериодОтчёта = ДатаОкончания;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидОперации) Тогда
		ДокументОбъект.ВидОперации = Перечисления.АиФ_ВидыОперацийМСФО.Переклассификация;
	КонецЕсли;

КонецПроцедуры

// Создаёт документы исключения ВГО по активным правилам (черновики с оборотами по указанным счетам).
//
Функция СоздатьДокументыИсключенияВГО(ДатаНачала, ДатаОкончания, ТолькоАктивныеПравила = Истина) Экспорт

	Созданные = Новый Массив;
	Правила = АктивныеПравилаВГО();

	Для Каждого Правило Из Правила Цикл

		Коды = Новый Массив;
		Если ЗначениеЗаполнено(Правило.КодСчетаВыручки) Тогда
			Коды.Добавить(Правило.КодСчетаВыручки);
		КонецЕсли;
		Если ЗначениеЗаполнено(Правило.КодСчетаЗатрат) Тогда
			Коды.Добавить(Правило.КодСчетаЗатрат);
		КонецЕсли;

		ОборотыПродавец = ОборотыБППоКодамСчетов(Правило.ОрганизацияПродавец, ДатаНачала, ДатаОкончания, Коды);
		ОборотыПокупатель = ОборотыБППоКодамСчетов(Правило.ОрганизацияПокупатель, ДатаНачала, ДатаОкончания, Коды);

		ДокументОбъект = Документы.АиФ_КорректировкаМСФО.СоздатьДокумент();
		ДокументОбъект.Дата = ДатаОкончания;
		ДокументОбъект.ПериодОтчёта = ДатаОкончания;
		ДокументОбъект.Организация = Правило.ОрганизацияПродавец;
		ДокументОбъект.ВидОперации = Перечисления.АиФ_ВидыОперацийМСФО.ИсключениеВГО;
		ДокументОбъект.Комментарий = СтрШаблон(НСтр("ru = 'Авто ВГО: %1'"), Правило.Наименование);

		ДобавитьСтрокиВГО(ДокументОбъект, ОборотыПродавец, Правило.КодСчетаВыручки, Истина);
		ДобавитьСтрокиВГО(ДокументОбъект, ОборотыПокупатель, Правило.КодСчетаЗатрат, Ложь);

		Если ДокументОбъект.Строки.Количество() = 0 Тогда
			// Черновик-заготовка, чтобы правило было видно в журнале.
			Стр = ДокументОбъект.Строки.Добавить();
			Стр.КодСчетаБП = Правило.КодСчетаВыручки;
			Стр.Содержание = НСтр("ru = 'Нет оборотов по счетам правила — заполните вручную'");
		КонецЕсли;

		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Созданные.Добавить(ДокументОбъект.Ссылка);

	КонецЦикла;

	Возврат Созданные;

КонецФункции

// Предпросмотр консолидированных движений МСФО за период.
//
Функция ТаблицаКонсолидации(ДатаНачала, ДатаОкончания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Организация КАК Организация,
	|	Движения.СтатьяМСФО КАК СтатьяМСФО,
	|	Движения.ВидОперации КАК ВидОперации,
	|	Движения.КодСчетаБП КАК КодСчетаБП,
	|	СУММА(Движения.Сумма) КАК Сумма,
	|	СУММА(Движения.СуммаВГО) КАК СуммаВГО,
	|	СУММА(Движения.Сумма) - СУММА(Движения.СуммаВГО) КАК СуммаКонсолидированная
	|ИЗ
	|	РегистрСведений.АиФ_ДвиженияМСФО КАК Движения
	|ГДЕ
	|	Движения.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Организация,
	|	Движения.СтатьяМСФО,
	|	Движения.ВидОперации,
	|	Движения.КодСчетаБП
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	СтатьяМСФО";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСтрокиВГО(ДокументОбъект, Обороты, КодСчета, ЭтоВыручка)

	Если Не ЗначениеЗаполнено(КодСчета) Тогда
		Возврат;
	КонецЕсли;

	Найденные = Обороты.НайтиСтроки(Новый Структура("КодСчетаБП", КодСчета));
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Сумма = Найденные[0].Сумма;
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрока = ДокументОбъект.Строки.Добавить();
	НоваяСтрока.КодСчетаБП = КодСчета;
	НоваяСтрока.СуммаВГО = Сумма;
	НоваяСтрока.Сумма = 0;
	НоваяСтрока.Содержание = ?(ЭтоВыручка,
		НСтр("ru = 'Исключение внутригрупповой выручки'"),
		НСтр("ru = 'Исключение внутригрупповых затрат'"));

КонецПроцедуры

#КонецОбласти
