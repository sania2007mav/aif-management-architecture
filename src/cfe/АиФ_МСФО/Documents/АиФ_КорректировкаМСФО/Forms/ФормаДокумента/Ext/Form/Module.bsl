
&НаКлиенте
Процедура ЗаполнитьПоКартеСчетов(Команда)

	Если Объект.Строки.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоКартеСчетовПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения,
			НСтр("ru = 'Табличная часть будет очищена и заполнена по карте счетов. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ЗаполнитьПоКартеСчетовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКартеСчетовПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоКартеСчетовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКартеСчетовНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	АиФ_МСФОСервер.ЗаполнитьКорректировкуПоКарте(ДокументОбъект);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Модифицированность = Истина;

КонецПроцедуры
