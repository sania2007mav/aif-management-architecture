
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ПериодПо) Тогда
		Объект.ПериодПо = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ПериодС) Тогда
		Объект.ПериодС = НачалоМесяца(Объект.ПериодПо);
	КонецЕсли;
	Объект.ТолькоАктивныеПравила = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредпросмотр(Команда)

	ЗаполнитьПредпросмотрНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредпросмотрНаСервере()

	Предпросмотр.Очистить();
	Таблица = АиФ_МСФОСервер.ТаблицаКонсолидации(Объект.ПериодС, КонецДня(Объект.ПериодПо));
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Предпросмотр.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИсключенияВГО(Команда)

	СоздатьИсключенияВГОНаСервере();
	ЗаполнитьПредпросмотрНаСервере();
	ПоказатьПредупреждение(, НСтр("ru = 'Документы исключения ВГО созданы (см. список ниже). Проведите их после проверки.'"));

КонецПроцедуры

&НаСервере
Процедура СоздатьИсключенияВГОНаСервере()

	Созданные = АиФ_МСФОСервер.СоздатьДокументыИсключенияВГО(
		Объект.ПериодС,
		КонецДня(Объект.ПериодПо),
		Объект.ТолькоАктивныеПравила);

	Части = Новый Массив;
	Для Каждого СсылкаДокумента Из Созданные Цикл
		Части.Добавить(Строка(СсылкаДокумента));
	КонецЦикла;
	СозданныеДокументы = СтрСоединить(Части, Символы.ПС);

КонецПроцедуры
