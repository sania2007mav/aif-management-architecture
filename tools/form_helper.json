{
  "title": "Помощник консолидации МСФО",
  "properties": { "autoTitle": false },
  "events": { "OnCreateAtServer": "ПриСозданииНаСервере" },
  "attributes": [
    { "name": "Объект", "type": "DataProcessorObject.АиФ_ПомощникКонсолидации", "main": true },
    {
      "name": "Предпросмотр",
      "type": "ValueTable",
      "columns": [
        { "name": "Организация", "type": "CatalogRef.Организации" },
        { "name": "СтатьяМСФО", "type": "CatalogRef.АиФ_СтатьиМСФО" },
        { "name": "ВидОперации", "type": "EnumRef.АиФ_ВидыОперацийМСФО" },
        { "name": "КодСчетаБП", "type": "string(20)" },
        { "name": "Сумма", "type": "decimal(15,2)" },
        { "name": "СуммаВГО", "type": "decimal(15,2)" },
        { "name": "СуммаКонсолидированная", "type": "decimal(15,2)" }
      ]
    },
    { "name": "СозданныеДокументы", "type": "string(0)" }
  ],
  "commands": [
    { "name": "ЗаполнитьПредпросмотр", "action": "ЗаполнитьПредпросмотр", "title": "Показать консолидацию" },
    { "name": "СоздатьИсключенияВГО", "action": "СоздатьИсключенияВГО", "title": "Создать документы ВГО" }
  ],
  "elements": [
    {
      "group": "vertical",
      "name": "Шапка",
      "children": [
        {
          "group": "horizontalIfPossible",
          "name": "Период",
          "children": [
            { "input": "ПериодС", "path": "Объект.ПериодС", "title": "С" },
            { "input": "ПериодПо", "path": "Объект.ПериодПо", "title": "По" },
            { "check": "ТолькоАктивныеПравила", "path": "Объект.ТолькоАктивныеПравила", "title": "Только активные правила ВГО" }
          ]
        },
        {
          "group": "horizontalIfPossible",
          "name": "Кнопки",
          "children": [
            { "button": "ЗаполнитьПредпросмотр", "command": "ЗаполнитьПредпросмотр" },
            { "button": "СоздатьИсключенияВГО", "command": "СоздатьИсключенияВГО" }
          ]
        },
        {
          "table": "Предпросмотр",
          "path": "Предпросмотр",
          "title": "Консолидированные движения МСФО",
          "readOnly": true,
          "columns": [
            { "input": "Организация", "path": "Предпросмотр.Организация" },
            { "input": "СтатьяМСФО", "path": "Предпросмотр.СтатьяМСФО" },
            { "input": "ВидОперации", "path": "Предпросмотр.ВидОперации" },
            { "input": "КодСчетаБП", "path": "Предпросмотр.КодСчетаБП" },
            { "input": "Сумма", "path": "Предпросмотр.Сумма" },
            { "input": "СуммаВГО", "path": "Предпросмотр.СуммаВГО" },
            { "input": "СуммаКонсолидированная", "path": "Предпросмотр.СуммаКонсолидированная" }
          ]
        },
        { "input": "СозданныеДокументы", "path": "СозданныеДокументы", "title": "Созданные документы", "multiline": true, "readOnly": true, "height": 4 }
      ]
    }
  ]
}
